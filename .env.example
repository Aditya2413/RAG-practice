# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development                  # development | production
APP_SECRET_KEY=                      # RS256 private key PEM (used to sign JWTs)
APP_PUBLIC_KEY=                      # RS256 public key PEM (used to verify JWTs)
APP_CORS_ORIGINS=http://localhost:3000

# ── PostgreSQL (AWS RDS) ──────────────────────────────────────────────────────
POSTGRES_HOST=pg-database.cxekc0wmoulk.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                   # RDS master password
POSTGRES_SSL=true                    # verify-full SSL for RDS
POSTGRES_SSL_CERT=./global-bundle.pem
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=                      # Only needed for Qdrant Cloud

# ── AWS RDS (psycopg2 direct — auth tables) ───────────────────────────────────
RDS_HOST=pg-database.cxekc0wmoulk.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB=postgres
RDS_USER=postgres
RDS_DB_PASSWORD=                     # plaintext password — dev/test only
RDS_SECRET_NAME=                     # AWS Secrets Manager secret name (production)
RDS_SSL_CERT=./global-bundle.pem     # path to RDS global CA bundle

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=ragbot-files
S3_PRESIGNED_URL_TTL=3600            # seconds

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_DEFAULT_MODEL=gpt-4o

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Cohere (reranking) ────────────────────────────────────────────────────────
COHERE_API_KEY=

# ── LangSmith ─────────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ragbot-production
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json                      # json | text  (use text for local dev)
